# Local launcher reads ../db/.env; these additional environment variables are optional.
# Optional local mail configuration: .env.mail.local (ignored). Never put a password here.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD_FILE=
MAIL_STORAGE=./storage/attachments
DOCUMENT_STORAGE=./storage/documents
APP_LOG_FILE=./logs/portal.log
